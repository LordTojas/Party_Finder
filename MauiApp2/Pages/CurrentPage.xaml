<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.Pages.CurrentPage"
             Title="Top események országszerte"
             BackgroundColor="#1E1E2F">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="25">

            <!-- Fejléc -->
            <Label Text="🌍 Top események országszerte"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,10,0,10" />

            <!-- Eseménylista -->
            <CollectionView x:Name="EventsCollectionView"
                            ItemsSource="{Binding TopEvents}"
                            SelectionMode="Single"
                            SelectionChanged="OnEventSelected">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="15"
                               Margin="0,8"
                               Padding="15"
                               HasShadow="True"
                               BackgroundColor="#2B2B3F"
                               BorderColor="#3C3C4D">

                            <VerticalStackLayout Spacing="8">

                                <!-- Esemény neve -->
                                <Label Text="{Binding EventName}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       LineBreakMode="WordWrap" />

                                <!-- Helyszín -->
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="📍" FontSize="14" TextColor="#9B59B6" />
                                    <Label Text="{Binding Location}"
                                           FontSize="14"
                                           TextColor="#DDDDDD" />
                                </HorizontalStackLayout>

                                <!-- Dátumok -->
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="🕒" FontSize="14" TextColor="#9B59B6" />
                                    <Label Text="{Binding StartDate, StringFormat='Kezdés: {0:yyyy.MM.dd HH:mm}'}"
                                           FontSize="13"
                                           TextColor="#CCCCCC" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="⏰" FontSize="14" TextColor="#9B59B6" />
                                    <Label Text="{Binding EndDate, StringFormat='Vége: {0:yyyy.MM.dd HH:mm}'}"
                                           FontSize="13"
                                           TextColor="#CCCCCC" />
                                </HorizontalStackLayout>

                                <!-- Értékelés -->
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="⭐" FontSize="14" TextColor="#FFD700" />
                                    <Label Text="{Binding AverageRating, StringFormat='{0:F1}/5'}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#FFD700" />
                                </HorizontalStackLayout>

                                <!-- Létrehozó -->
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="👤" FontSize="13" TextColor="#9B59B6" />
                                    <Label Text="{Binding CreatorUsername, StringFormat='Létrehozta: {0}'}"
                                           FontSize="13"
                                           TextColor="#AAAAAA" />
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Ha nincs esemény -->
            <Label Text="Nincs elérhető esemény 😔"
                   FontSize="16"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"
                   IsVisible="{Binding TopEvents.Count, Converter={StaticResource BoolConverter}, ConverterParameter=False}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
