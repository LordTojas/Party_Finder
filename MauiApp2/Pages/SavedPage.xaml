<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MauiApp2.Converters"
             x:Class="MauiApp2.Pages.SavedPage"
             Title="Mentett Események"
             BackgroundColor="#1E1E2F">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="25">

            <!-- Felhasználói statisztikák -->
            <Frame BackgroundColor="#2B2B3F"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="#3C3C4D">

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding UserName, StringFormat='Üdv, {0}!'}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding AttendedEventsCount, StringFormat='🎉 Már {0} eseményen jelezted a részvételedet!'}"
                           FontSize="14"
                           TextColor="#CCCCCC"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding CreatedEventsCount, StringFormat='🛠️ {0} eseményt készítettél eddig'}"
                           FontSize="14"
                           TextColor="#CCCCCC"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding AverageRating, StringFormat='⭐ Átlagos értékelésed: {0:F1}/5'}"
                           FontSize="14"
                           TextColor="#4CAF50"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Mentett események -->
            <CollectionView x:Name="SavedEventsCollectionView"
                            ItemsSource="{Binding SavedEvents}"
                            IsVisible="{Binding HasSavedEvents}"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="15"
                               Padding="15"
                               Margin="0,8"
                               HasShadow="True"
                               BackgroundColor="#2B2B3F"
                               BorderColor="#3C3C4D">

                            <VerticalStackLayout Spacing="8">

                                <!-- Státusz -->
                                <Frame CornerRadius="8"
                                       Padding="6,3"
                                       WidthRequest="100"
                                       BackgroundColor="{Binding StatusColor}"
                                       HorizontalOptions="Start">
                                    <Label Text="{Binding StatusText}"
                                           TextColor="White"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"/>
                                </Frame>

                                <!-- Esemény neve -->
                                <Label Text="{Binding EventName}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="WordWrap"/>

                                <!-- Helyszín -->
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="📍" FontSize="14" TextColor="#9B59B6"/>
                                    <Label Text="{Binding Location}"
                                           FontSize="14"
                                           TextColor="#CCCCCC"/>
                                </HorizontalStackLayout>

                                <!-- Kezdés -->
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="🕒" FontSize="14" TextColor="#9B59B6"/>
                                    <Label Text="{Binding StartDate, StringFormat='Kezdés: {0:yyyy.MM.dd}'}"
                                           FontSize="13"
                                           TextColor="#BBBBBB"/>
                                    <Label Text="{Binding StartTime, Converter={StaticResource TimeSpanToStringConverter}, FallbackValue='N/A'}"
                                           FontSize="13"
                                           TextColor="#BBBBBB"/>
                                </HorizontalStackLayout>

                                <!-- Vége -->
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="⏰" FontSize="14" TextColor="#9B59B6"/>
                                    <Label Text="{Binding EndDate, StringFormat='Vége: {0:yyyy.MM.dd}'}"
                                           FontSize="13"
                                           TextColor="#BBBBBB"/>
                                    <Label Text="{Binding EndTime, Converter={StaticResource TimeSpanToStringConverter}, FallbackValue='N/A'}"
                                           FontSize="13"
                                           TextColor="#BBBBBB"/>
                                </HorizontalStackLayout>

                                <!-- Kategória és korhatár -->
                                <HorizontalStackLayout Spacing="8" Margin="0,5,0,0">
                                    <Label Text="📂" FontSize="14" TextColor="#9B59B6"/>
                                    <Label Text="{Binding Category}"
                                           FontSize="13"
                                           TextColor="#CCCCCC"/>
                                    <Label Text="🔞" FontSize="14" TextColor="#9B59B6"/>
                                    <Label Text="{Binding AgeRestriction, StringFormat='{0}', FallbackValue='Nincs megadva'}"
                                           FontSize="13"
                                           TextColor="#CCCCCC"/>
                                </HorizontalStackLayout>

                                <!-- Értékelés (lejárt eseményeknél) -->
                                <HorizontalStackLayout Spacing="10"
                                                       Margin="0,10,0,0"
                                                       IsVisible="{Binding IsExpired}">
                                    <Label Text="⭐ Értékelés:"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           VerticalOptions="Center" />

                                    <Picker x:Name="RatingPicker"
                                            Title="Válassz értékelést"
                                            WidthRequest="100"
                                            TextColor="White"
                                            BackgroundColor="#3C3C4D">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:Int32}">
                                                <x:Int32>1</x:Int32>
                                                <x:Int32>2</x:Int32>
                                                <x:Int32>3</x:Int32>
                                                <x:Int32>4</x:Int32>
                                                <x:Int32>5</x:Int32>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                        <Picker.SelectedItem>
                                            <Binding Path="Rating" Mode="TwoWay" />
                                        </Picker.SelectedItem>
                                    </Picker>

                                    <Button Text="💾 Mentés"
                                            BackgroundColor="#4CAF50"
                                            TextColor="White"
                                            CornerRadius="10"
                                            FontAttributes="Bold"
                                            HeightRequest="40"
                                            WidthRequest="110"
                                            Command="{Binding SaveRatingCommand}"
                                            CommandParameter="{Binding Id}" />
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Üres események -->
            <Label Text="📭 Még nem mentettél eseményeket"
                   FontSize="16"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"
                   IsVisible="{Binding HasNoSavedEvents}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
