<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MauiApp2.Converters"
             x:Class="MauiApp2.Pages.SupriseMePage"
             Title="Csak Neked"
             BackgroundColor="#1E1E2F">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="25">

            <!-- Fejléc -->
            <Label Text="🎲 Meglepetés esemény kereső"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,10,0,10" />

            <!-- Szűrők kártyában -->
            <Frame BackgroundColor="#2B2B3F"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="#3C3C4D">

                <VerticalStackLayout Spacing="15">

                    <!-- Távolság -->
                    <Label Text="📍 Hány km-es körzetben keresel?"
                           FontSize="18"
                           TextColor="White"
                           FontAttributes="Bold" />
                    <Entry x:Name="RadiusEntry"
                           Placeholder="Írd be a körzetet km-ben"
                           Keyboard="Numeric"
                           TextColor="White"
                           BackgroundColor="#3C3C4D"
                           WidthRequest="300" />

                    <!-- Dátum -->
                    <Label Text="📅 Melyik napra keresel eseményt?"
                           FontSize="18"
                           TextColor="White"
                           FontAttributes="Bold" />
                    <DatePicker x:Name="DatePicker"
                                MinimumDate="2023-01-01"
                                MaximumDate="2025-12-31"
                                Format="yyyy-MM-dd"
                                WidthRequest="300"
                                TextColor="White"
                                BackgroundColor="#3C3C4D" />

                    <!-- Korhatár -->
                    <Label Text="🔞 Korhatár szűrés"
                           FontSize="18"
                           TextColor="White"
                           FontAttributes="Bold" />
                    <Picker x:Name="AgeLimitPicker"
                            Title="Válassz korhatárt"
                            ItemsSource="{Binding AgeGroups}"
                            SelectedItem="{Binding SelectedAgeGroup, Mode=TwoWay}"
                            WidthRequest="300"
                            TextColor="White"
                            BackgroundColor="#3C3C4D" />
                </VerticalStackLayout>
            </Frame>

            <!-- Meglepetés gomb -->
            <Button Text="✨ Meglepetés esemény keresése"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="55"
                    WidthRequest="300"
                    HorizontalOptions="Center"
                    Clicked="OnSurpriseButtonClicked" />

            <!-- Talált esemény -->
            <Frame x:Name="ResultFrame"
                   IsVisible="{Binding HasEvent}"
                   BackgroundColor="#2B2B3F"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="#3C3C4D">

                <VerticalStackLayout Spacing="10">

                    <!-- Státusz -->
                    <Frame CornerRadius="8"
                           Padding="6,3"
                           WidthRequest="100"
                           BackgroundColor="{Binding SelectedEvent.StatusColor}"
                           HorizontalOptions="Start">
                        <Label Text="{Binding SelectedEvent.StatusText}"
                               TextColor="White"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>
                    </Frame>

                    <!-- Esemény neve -->
                    <Label x:Name="EventNameLabel"
                           Text="{Binding SelectedEvent.EventName}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <!-- Helyszín -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="📍" FontSize="14" TextColor="#9B59B6" />
                        <Label x:Name="LocationLabel"
                               Text="{Binding SelectedEvent.Location, StringFormat='{0}'}"
                               FontSize="14"
                               TextColor="#CCCCCC" />
                    </HorizontalStackLayout>

                    <!-- Kezdés -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="🕒" FontSize="14" TextColor="#9B59B6" />
                        <Label Text="{Binding SelectedEvent.StartDate, StringFormat='Kezdés: {0:yyyy.MM.dd}'}"
                               FontSize="13"
                               TextColor="#BBBBBB" />
                        <Label Text="{Binding SelectedEvent.StartTime, Converter={StaticResource TimeSpanToStringConverter}}"
                               FontSize="13"
                               TextColor="#BBBBBB" />
                    </HorizontalStackLayout>

                    <!-- Vége -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="⏰" FontSize="14" TextColor="#9B59B6" />
                        <Label Text="{Binding SelectedEvent.EndDate, StringFormat='Vége: {0:yyyy.MM.dd}'}"
                               FontSize="13"
                               TextColor="#BBBBBB" />
                        <Label Text="{Binding SelectedEvent.EndTime, Converter={StaticResource TimeSpanToStringConverter}}"
                               FontSize="13"
                               TextColor="#BBBBBB" />
                    </HorizontalStackLayout>

                    <!-- Kategória -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="📂" FontSize="14" TextColor="#9B59B6" />
                        <Label Text="{Binding SelectedEvent.Category}"
                               FontSize="13"
                               TextColor="#CCCCCC" />
                    </HorizontalStackLayout>

                    <!-- Korhatár -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="🔞" FontSize="14" TextColor="#9B59B6" />
                        <Label x:Name="AgeLimitLabel"
                               Text="{Binding SelectedEvent.AgeRestriction, StringFormat='{0}'}"
                               FontSize="13"
                               TextColor="#CCCCCC" />
                    </HorizontalStackLayout>

                    <!-- Készítő -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="👤 Készítette:"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="{Binding SelectedEvent.CreatorName}"
                               FontSize="13"
                               TextColor="#9B59B6">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectedEvent.ShowCreatorDetailsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Gombok -->
                    <HorizontalStackLayout Spacing="12" Margin="0,10,0,0" HorizontalOptions="Center">
                        <Button Text="💜 Kedvelés"
                                BackgroundColor="#9B59B6"
                                TextColor="White"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                HeightRequest="40"
                                WidthRequest="130"
                                Command="{Binding SelectedEvent.LikeCommand}"
                                CommandParameter="{Binding SelectedEvent.Id}" />
                        <Button Text="🎟️ Ott leszek"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                HeightRequest="40"
                                WidthRequest="130"
                                Command="{Binding SelectedEvent.BeThereCommand}"
                                CommandParameter="{Binding SelectedEvent.Id}" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Üres állapot -->
            <Label Text="😔 Nincs elérhető esemény a megadott feltételekkel."
                   IsVisible="{Binding HasNoEvent}"
                   HorizontalOptions="Center"
                   FontSize="16"
                   TextColor="#AAAAAA" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
