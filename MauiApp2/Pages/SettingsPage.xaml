<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.Pages.SettingsPage"
             Title="Beállítások"
             BackgroundColor="#1E1E2F">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="25">

            
            <Label Text="⚙️ Fiókbeállítások"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,10,0,10" />

            
            <Frame BackgroundColor="#2B2B3F"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="#3C3C4D">
                <VerticalStackLayout Spacing="10">

                    <Label Text="🖼️ Profilkép"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Button x:Name="UploadImageButton"
                            Text="Kép kiválasztása"
                            BackgroundColor="#9B59B6"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="45"
                            Clicked="OnUploadImageButtonClicked" />

                </VerticalStackLayout>
            </Frame>

            
            <Frame BackgroundColor="#2B2B3F"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="#3C3C4D">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📝 Leírás (max. 250 karakter)"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Editor x:Name="DescriptionEditor"
                            Placeholder="Írj egy rövid bemutatkozást magadról..."
                            MaxLength="250"
                            HeightRequest="100"
                            TextColor="White"
                            BackgroundColor="#3C3C4D"
                            AutoSize="TextChanges" />
                </VerticalStackLayout>
            </Frame>

          
            <Frame BackgroundColor="#2B2B3F"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="#3C3C4D">
                <VerticalStackLayout Spacing="10">
                    <Label Text="👥 Barátkód"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label x:Name="FriendCodeLabel"
                           Text="N/A"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#9B59B6" />
                </VerticalStackLayout>
            </Frame>

          
            <Frame BackgroundColor="#2B2B3F"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="#3C3C4D">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📧 Bejelentkezési adatok"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Label Text="Email:"
                           FontSize="14"
                           TextColor="#BBBBBB" />
                    <Label x:Name="EmailLabel"
                           FontSize="16"
                           TextColor="White" />

                    <Label Text="Jelszó:"
                           FontSize="14"
                           TextColor="#BBBBBB"
                           Margin="0,5,0,0" />

                    <HorizontalStackLayout Spacing="10">
                        <Label x:Name="PasswordLabel"
                               Text="********"
                               FontSize="16"
                               TextColor="White"
                               VerticalOptions="Center" />
                        <Button x:Name="ChangePasswordButton"
                                Text="Jelszó módosítása"
                                BackgroundColor="#9B59B6"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="40"
                                Clicked="OnChangePasswordButtonClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            
            <Frame BackgroundColor="#2B2B3F"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="#3C3C4D">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Button x:Name="SaveButton"
                            Text="💾 Mentés"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            WidthRequest="200"
                            Clicked="OnSaveButtonClicked" />
                    <Button x:Name="DeleteAccountButton"
                            Text="🗑️ Fiók törlése"
                            BackgroundColor="#E74C3C"
                            TextColor="White"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            WidthRequest="200"
                            Clicked="OnDeleteAccountButtonClicked" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
