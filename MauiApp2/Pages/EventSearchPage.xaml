<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MauiApp2.Converters"
             x:Class="MauiApp2.Pages.EventSearchPage"
             BackgroundColor="#121212"
             Title="Eseménykereső">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="25">

            <!-- Fejléc -->
            <Frame CornerRadius="20" Padding="25" BackgroundColor="#1E1E1E" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="🔎 Eseménykereső"
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#BB86FC"/>
                    <Label Text="Keress név, dátum, műfaj vagy távolság alapján!"
                           FontSize="16"
                           HorizontalOptions="Center"
                           TextColor="#BBBBBB" />
                </VerticalStackLayout>
            </Frame>

            <!-- Szűrők -->
            <Frame CornerRadius="20" Padding="20" BackgroundColor="#1E1E1E" HasShadow="True">
                <VerticalStackLayout Spacing="20">

                    <!-- Esemény név -->
                    <Label Text="📝 Esemény neve"
                           FontSize="18"
                           TextColor="#03DAC6"
                           FontAttributes="Bold" />

                    <Frame CornerRadius="10"
                           Padding="10"
                           BackgroundColor="#2C2C2C"
                           HasShadow="False">
                        <Entry x:Name="NameEntry"
                               Placeholder="Add meg az esemény nevét..."
                               Text="{Binding SearchName, Mode=TwoWay}"
                               BackgroundColor="Transparent"
                               TextColor="White"
                               PlaceholderColor="#888" />
                    </Frame>

                    <!-- Dátum szűrő -->
                    <Label Text="📅 Dátum intervallum"
                           FontSize="18"
                           TextColor="#03DAC6"
                           FontAttributes="Bold" />

                    <HorizontalStackLayout Spacing="10">
                        <VerticalStackLayout>
                            <Label Text="Kezdés:" FontSize="14" TextColor="#BBBBBB" />
                            <DatePicker x:Name="StartDatePicker"
                                        Date="{Binding StartDateFilter, Mode=TwoWay}"
                                        Format="yyyy-MM-dd"
                                        TextColor="White"
                                        BackgroundColor="#2C2C2C" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Vége:" FontSize="14" TextColor="#BBBBBB" />
                            <DatePicker x:Name="EndDatePicker"
                                        Date="{Binding EndDateFilter, Mode=TwoWay}"
                                        Format="yyyy-MM-dd"
                                        TextColor="White"
                                        BackgroundColor="#2C2C2C" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Zenei műfaj -->
                    <Label Text="🎵 Zenei műfaj"
                           FontSize="18"
                           TextColor="#03DAC6"
                           FontAttributes="Bold" />
                    <Picker x:Name="MusicGenrePicker"
                            Title="Válassz műfajt"
                            ItemsSource="{Binding MusicGenres}"
                            SelectedItem="{Binding SelectedMusicGenre, Mode=TwoWay}"
                            BackgroundColor="#2C2C2C"
                            TextColor="White"
                            TitleColor="#888"/>

                    <!-- Korhatár szűrő -->
                    <Label Text="🎫 Korhatár"
                           FontSize="18"
                           TextColor="#03DAC6"
                           FontAttributes="Bold" />
                    <Picker x:Name="AgeGroupPicker"
                            Title="Válassz korhatárt"
                            BackgroundColor="#2C2C2C"
                            TextColor="White"
                            TitleColor="#888"
                            ItemsSource="{Binding AgeGroups}"
                            SelectedItem="{Binding SelectedAgeGroup, Mode=TwoWay}" />

                    <!-- Távolság szűrő -->
                    <Label Text="🎯 Keresési körzet"
                           FontSize="18"
                           TextColor="#03DAC6"
                           FontAttributes="Bold" />
                    <Slider x:Name="RadiusSlider"
                            Minimum="1"
                            Maximum="1000"
                            Value="10"
                            ThumbColor="#BB86FC"
                            MaximumTrackColor="#333333"
                            MinimumTrackColor="#BB86FC" />
                    <Label Text="{Binding Value, Source={x:Reference RadiusSlider}, StringFormat='{0:F0} km'}"
                           HorizontalOptions="Center"
                           TextColor="White"
                           FontSize="14"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Keresés gomb -->
            <Button Text="✨ Keresés"
                    FontSize="20"
                    HeightRequest="55"
                    BackgroundColor="#BB86FC"
                    TextColor="White"
                    CornerRadius="30"
                    HorizontalOptions="Center"
                    WidthRequest="200"
                    Clicked="OnSearchClicked" />

            <!-- Találatok -->
            <Label Text="🔔 Találatok"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#FFB74D"
                   IsVisible="{Binding HasResults}"
                   Margin="10,0,0,0" />

            <CollectionView x:Name="EventsCollectionView"
                            ItemsSource="{Binding FilteredEvents}"
                            IsVisible="{Binding HasResults}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="20"
                               Padding="15"
                               Margin="0,10,0,10"
                               BackgroundColor="#1E1E1E"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="8">

                                <!-- Státusz -->
                                <Border BackgroundColor="{Binding StatusColor}"
                                        Padding="5,2"
                                        StrokeShape="RoundRectangle 10"
                                        HorizontalOptions="Start">
                                    <Label Text="{Binding StatusText}"
                                           FontSize="12"
                                           TextColor="White"/>
                                </Border>

                                <!-- Esemény neve -->
                                <Label Text="{Binding EventName}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White"/>

                                <Label Text="{Binding Location, StringFormat='📍 {0}'}"
                                       FontSize="14"
                                       TextColor="#BBBBBB" />

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding StartDate, StringFormat='🕒 {0:yyyy-MM-dd}'}"
                                           FontSize="14"
                                           TextColor="#CCCCCC"/>
                                    <Label Text="{Binding StartTime, Converter={StaticResource TimeSpanToStringConverter}}"
                                           FontSize="14"
                                           TextColor="#CCCCCC"/>
                                </HorizontalStackLayout>

                                <Label Text="{Binding Category, StringFormat='🎶 Kategória: {0}'}"
                                       FontSize="14"
                                       TextColor="#CCCCCC"/>

                                <Label Text="{Binding MusicGenre, StringFormat='🎵 Műfaj: {0}'}"
                                       FontSize="14"
                                       TextColor="#CCCCCC"/>

                                <Label Text="{Binding AgeRestriction, StringFormat='🔞 Korhatár: {0}'}"
                                       FontSize="14"
                                       TextColor="#CCCCCC"/>

                                <!-- Készítő -->
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="👤" FontSize="14"/>
                                    <Label Text="{Binding CreatorName}"
                                           FontSize="14"
                                           TextColor="#03DAC6">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowCreatorDetailsCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>

                                <!-- Akciógombok -->
                                <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                                    <Button Text="❤️ Kedvelés"
                                            BackgroundColor="#E91E63"
                                            TextColor="White"
                                            CornerRadius="25"
                                            FontSize="14"
                                            Command="{Binding LikeCommand}"
                                            CommandParameter="{Binding Id}" />
                                    <Button Text="✅ Ott leszek"
                                            BackgroundColor="#4CAF50"
                                            TextColor="White"
                                            CornerRadius="25"
                                            FontSize="14"
                                            Command="{Binding BeThereCommand}"
                                            CommandParameter="{Binding Id}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Üres találat -->
            <Label Text="😕 Nincs találat a megadott szűrők alapján."
                   FontSize="16"
                   IsVisible="{Binding HasNoResults}"
                   HorizontalOptions="Center"
                   TextColor="#E57373"
                   Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
