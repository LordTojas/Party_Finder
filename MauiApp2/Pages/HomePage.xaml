<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.Pages.HomePage"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="25">

            
            <Label Text="Üdv újra a PartyFinderben!"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,40,0,20"/>

            
            <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="20" HasShadow="True">
                <Frame.Shadow>
                    <Shadow Brush="#000000" Opacity="0.5" Radius="15" Offset="5,5"/>
                </Frame.Shadow>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Navigáció"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#BB86FC"
                           Margin="0,0,0,10"/>

                    <Button Text="Keresés"
                            x:Name="SearchButton"
                            FontSize="18"
                            HeightRequest="55"
                            BackgroundColor="#BB86FC"
                            TextColor="White"
                            CornerRadius="25"
                            Clicked="OnButtonClicked"/>

                    <Button Text="Meglepetés"
                            x:Name="RandomButton"
                            FontSize="18"
                            HeightRequest="55"
                            BackgroundColor="#03DAC6"
                            TextColor="Black"
                            CornerRadius="25"
                            Clicked="OnButtonClicked"/>

                    <Button Text="Beállítások"
                            x:Name="SettingsButton"
                            FontSize="18"
                            HeightRequest="55"
                            BackgroundColor="#4A90E2"
                            TextColor="White"
                            CornerRadius="25"
                            Clicked="OnButtonClicked"/>
                </VerticalStackLayout>
            </Frame>

            
            <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="20" HasShadow="True">
                <Frame.Shadow>
                    <Shadow Brush="#000000" Opacity="0.5" Radius="15" Offset="5,5"/>
                </Frame.Shadow>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Események"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#FFB74D"
                           Margin="0,0,0,10"/>

                    <Button Text="Aktuális események"
                            x:Name="CurrentEventsButton"
                            FontSize="18"
                            HeightRequest="55"
                            BackgroundColor="#FFB74D"
                            TextColor="Black"
                            CornerRadius="25"
                            Clicked="OnButtonClicked"/>

                    <Button Text="Eseményeim"
                            x:Name="MyEventsButton"
                            FontSize="18"
                            HeightRequest="55"
                            BackgroundColor="#FFD180"
                            TextColor="Black"
                            CornerRadius="25"
                            Clicked="OnButtonClicked"/>

                    <Button Text="Esemény létrehozása"
                            x:Name="CreateEventButton"
                            FontSize="18"
                            HeightRequest="55"
                            BackgroundColor="#9B59B6"
                            TextColor="White"
                            CornerRadius="25"
                            Clicked="OnButtonClicked"/>
                </VerticalStackLayout>
            </Frame>

            
            <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="20" HasShadow="True">
                <Frame.Shadow>
                    <Shadow Brush="#000000" Opacity="0.5" Radius="15" Offset="5,5"/>
                </Frame.Shadow>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Közösség"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#F7B731"
                           Margin="0,0,0,10"/>

                    <Button Text="Kedvencek"
                            x:Name="Button1"
                            FontSize="18"
                            HeightRequest="55"
                            BackgroundColor="#F7B731"
                            TextColor="Black"
                            CornerRadius="25"
                            Clicked="OnButtonClicked"/>

                    <Button Text="Közösség"
                            x:Name="Button2"
                            FontSize="18"
                            HeightRequest="55"
                            BackgroundColor="#F9CA24"
                            TextColor="Black"
                            CornerRadius="25"
                            Clicked="OnButtonClicked"/>

                    <Button Text="Csak Neked"
                            x:Name="Button3"
                            FontSize="18"
                            HeightRequest="55"
                            BackgroundColor="#F5CD79"
                            TextColor="Black"
                            CornerRadius="25"
                            Clicked="OnButtonClicked"/>

                    <Button Text="Mentett Események"
                            x:Name="Button4"
                            FontSize="18"
                            HeightRequest="55"
                            BackgroundColor="#F5CD79"
                            TextColor="Black"
                            CornerRadius="25"
                            Clicked="OnButtonClicked"/>
                </VerticalStackLayout>
            </Frame>

            
            <Button Text="Kijelentkezés"
                    x:Name="LogoutButton"
                    FontSize="16"
                    HeightRequest="50"
                    BackgroundColor="#FF3B30"
                    TextColor="White"
                    CornerRadius="25"
                    Clicked="OnButtonClicked"
                    Margin="0,10,0,40"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
