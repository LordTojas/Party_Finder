<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.Pages.ChangePasswordPage"
             Title="Jelszó módosítása"
             BackgroundColor="#1E1E2F">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="25">

            <!-- Címsor -->
            <Label Text="🔐 Jelszó módosítása"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,10" />

            <!-- Új jelszó mező -->
            <Frame BackgroundColor="#2B2B3F"
                   CornerRadius="12"
                   Padding="15"
                   HasShadow="False">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Új jelszó"
                           FontSize="16"
                           TextColor="#CCCCCC" />
                    <Entry x:Name="NewPasswordEntry"
                           Placeholder="Add meg az új jelszavadat"
                           IsPassword="True"
                           TextColor="White"
                           PlaceholderColor="#888888"
                           BackgroundColor="Transparent" />
                </VerticalStackLayout>
            </Frame>

            <!-- Jelszó megerősítése -->
            <Frame BackgroundColor="#2B2B3F"
                   CornerRadius="12"
                   Padding="15"
                   HasShadow="False">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Új jelszó megerősítése"
                           FontSize="16"
                           TextColor="#CCCCCC" />
                    <Entry x:Name="ConfirmPasswordEntry"
                           Placeholder="Add meg újra az új jelszavadat"
                           IsPassword="True"
                           TextColor="White"
                           PlaceholderColor="#888888"
                           BackgroundColor="Transparent" />
                </VerticalStackLayout>
            </Frame>

            <!-- Mentés gomb -->
            <Button x:Name="SavePasswordButton"
                    Text="✅ Jelszó mentése"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    Clicked="OnSavePasswordButtonClicked"
                    Margin="0,10,0,0" />

           

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
