<?xml version="1.0" encoding="utf-8" ?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Alapértelmezett alkalmazás téma -->
    <style name="Maui.MainTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Színek -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Világos/sötét mód támogatás -->
        <item name="android:forceDarkAllowed">true</item>

        <!-- Material text appearance fix -->
        <item name="textAppearanceBody1">@style/TextAppearance.MaterialComponents.Body1</item>
        <item name="textAppearanceButton">@style/TextAppearance.MaterialComponents.Button</item>

        <!-- StatusBar és navigációs sáv -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">?attr/colorPrimary</item>
    </style>

    <!-- ActionBar nélküli verzió (ha kell) -->
    <style name="Maui.MainTheme.NoActionBar" parent="Maui.MainTheme" />

</resources>
